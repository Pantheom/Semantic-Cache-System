# ==========================================
# Hybrid Semantic Cache — Environment Config
# ==========================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ------------------------------------------
# SUPABASE (required)
# ------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key"

# Only needed if your table has strict Row Level Security (RLS).
# Use the service_role secret key to bypass RLS during seeding.
SUPABASE_SERVICE_KEY="your-service-role-key"

# ------------------------------------------
# LLM PROVIDER API KEYS (optional)
# ------------------------------------------
# Uncomment and fill in whichever provider you integrate in main.py

# GROQ_API_KEY="gsk_your_groq_key_here"
# OPENAI_API_KEY="sk-proj-your_openai_key_here"

# ------------------------------------------
# HUGGING FACE (optional)
# ------------------------------------------
# Required only for private HuggingFace datasets during seeding.
# HF_TOKEN="hf_your_token_here"

# ------------------------------------------
# BRIDGE API — axiom_bridge.py (Port 8002)
# ------------------------------------------
# Shared secret between your application and the Bridge API.
# Set the same value in both services. Use a long random string.
BRIDGE_API_KEY="replace-with-a-strong-random-secret"

# Internal URL of the main cache API (main.py) — same machine, do not change.
CACHE_API_URL="http://127.0.0.1:8000"

# Port the bridge API listens on. Open this in your EC2 Security Group.
BRIDGE_PORT=8002

# Timeout (seconds) for upstream calls to the cache API.
# Tier 3 (LLM generation) can be slow — set generously.
UPSTREAM_TIMEOUT_S=30.0



